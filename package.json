{
    "name": "slc",
    "type": "module",
    "scripts": {
        "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig-test.json",
        "test": "node --test",
        "lint": "eslint .",
        "format": "prettier --write .",
        "build": "vendeps",
        "postinstall": "vendeps"
    },
    "devDependencies": {
        "@types/d3": "^7.4.3",
        "@types/markdown-it": "^14.1.2",
        "@types/node": "^25.6.0",
        "@types/pako": "^2.0.4",
        "cheerio": "^1.1.0",
        "esbuild": "^0.25.10",
        "eslint": "^9.34.0",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.6.2",
        "typescript": "^6.0.3",
        "vendeps": "^1.0.1"
    },
    "dependencies": {
        "d3": "^7.9.0",
        "markdown-it": "^14.1.0",
        "pako": "^2.1.0",
        "vue": "^3.5.22",
        "yaml": "^2.8.1"
    },
    "vendeps": {
        "vue": {
            "from": "vue/dist/vue.esm-bundler.js",
            "define": {
                "__VUE_OPTIONS_API__": "true",
                "__VUE_PROD_DEVTOOLS__": "true",
                "__VUE_PROD_HYDRATION_MISMATCH_DETAILS__": "false"
            }
        },
        "markdown-it": {
            "export": "{ default as MarkdownIt }"
        }
    }
}
